<DATAFILE>

[FILEINFO]
file='../data_monolix/data_for_monolix_grippe_A_24_26_vfinal.csv'
delimiter = comma
header={ID_infection, time, obs, censor, Ct_diff, tag_inf, sexe, age_cat, season, epidemic_period, statut_vaccin, tSS}

[CONTENT]
ID_infection = {use=identifier}
time = {use=time}
censor = {use=censored}
Ct_diff = {use=observation, type=continuous}
sexe = {use=covariate, type=categorical}
age_cat = {use=covariate, type=categorical}
season = {use=covariate, type=categorical}
epidemic_period = {use=covariate, type=categorical}
statut_vaccin = {use=covariate, type=categorical}

[SETTINGS]
dataType = {'Ct_diff'=plasma}

<MODEL>

[COVARIATE]
input = {age_cat, epidemic_period, season, sexe, statut_vaccin}

age_cat = {type=categorical, categories={'18-65', '5-18', '<5', '>65'}}
epidemic_period = {type=categorical, categories={'Phase 1', 'Phase 2', 'Phase 3'}}
season = {type=categorical, categories={'24_25', '25_26'}}
sexe = {type=categorical, categories={'Female', 'Male'}}
statut_vaccin = {type=categorical, categories={'0', '1'}}

DEFINITION:
age_cat_fus =
{
  transform = age_cat, 
  categories = {
  'G_18-65' = {'18-65'},
  'G_5-18_<5' = {'5-18', '<5'},
  'G_>65' = {'>65'}  }, 
  reference = 'G_18-65'
}

epidemic_period_red =
{
  transform = epidemic_period, 
  categories = {
  'G_Phase 2' = {'Phase 2'},
  'G_Phase 1' = {'Phase 1'},
  'G_Phase 3' = {'Phase 3'}  }, 
  reference = 'G_Phase 2'
}

age_fus_sup18 =
{
  transform = age_cat, 
  categories = {
  'G_5-18_<5' = {'5-18', '<5'},
  'G_18-65_>65' = {'18-65', '>65'}  }, 
  reference = 'G_18-65_>65'
}

age_fus_old =
{
  transform = age_cat, 
  categories = {
  'G_<5' = {'<5'},
  'G_5-18' = {'5-18'},
  'G_18-65_>65' = {'18-65', '>65'}  }, 
  reference = 'G_18-65_>65'
}

period_fus =
{
  transform = epidemic_period, 
  categories = {
  'G_Phase 2_Phase 3' = {'Phase 2', 'Phase 3'},
  'G_Phase 1' = {'Phase 1'}  }, 
  reference = 'G_Phase 2_Phase 3'
}

[INDIVIDUAL]
input = {beta_pop, c_pop, delta_pop, omega_delta, eta_pop, p_pop, tinc_pop, omega_beta, season, beta_p_season_25_26, age_fus_old, beta_delta_age_fus_old_G__5, beta_delta_age_fus_old_G_5_18, beta_delta_season_25_26, period_fus, beta_delta_period_fus_G_Phase_1}

season = {type=categorical, categories={'24_25', '25_26'}}
age_fus_old = {type=categorical, categories={'G_<5', 'G_5-18', 'G_18-65_>65'}}
period_fus = {type=categorical, categories={'G_Phase 2_Phase 3', 'G_Phase 1'}}

DEFINITION:
beta = {distribution=logNormal, typical=beta_pop, sd=omega_beta}
c = {distribution=logNormal, typical=c_pop, no-variability}
delta = {distribution=logNormal, typical=delta_pop, covariate={age_fus_old, season, period_fus}, coefficient={{beta_delta_age_fus_old_G__5, beta_delta_age_fus_old_G_5_18, 0}, {0, beta_delta_season_25_26}, {0, beta_delta_period_fus_G_Phase_1}}, sd=omega_delta}
eta = {distribution=logNormal, typical=eta_pop, no-variability}
p = {distribution=logNormal, typical=p_pop, covariate=season, coefficient={0, beta_p_season_25_26}, no-variability}
tinc = {distribution=logNormal, typical=tinc_pop, no-variability}

[LONGITUDINAL]
input = {a}

file = '../structural_model/modele_TV_flu_A_4e6.txt'

DEFINITION:
Ct_diff_ = {distribution=normal, prediction=Ct_diff, errorModel=constant(a)}

<FIT>
data = 'Ct_diff'
model = Ct_diff_

<PARAMETER>
a = {value=5.0788236, method=MLE}
beta_delta_age_fus_old_G_5_18 = {value=-0.2501414, method=MLE}
beta_delta_age_fus_old_G__5 = {value=-0.2457391, method=MLE}
beta_delta_period_fus_G_Phase_1 = {value=0, method=MLE}
beta_delta_season_25_26 = {value=0, method=MLE}
beta_p_season_25_26 = {value=0.5169439, method=MLE}
beta_pop = {value=0.000003259411, method=MLE}
c_pop = {value=10, method=FIXED}
delta_pop = {value=0.7262328, method=MLE}
eta_pop = {value=0.0001, method=FIXED}
omega_beta = {value=0.9258385, method=MLE}
omega_delta = {value=0.3878491, method=MLE}
p_pop = {value=85281.262, method=MLE}
tinc_pop = {value=2, method=FIXED}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = Linearization)
logLikelihood(method = Linearization)
plotResult(method = {indfits, parameterdistribution, covariancemodeldiagnosis, covariatemodeldiagnosis, obspred, vpc, residualsscatter, residualsdistribution, randomeffects, saemresults })

[SETTINGS]
GLOBAL:
exportpath = 'RELAB_flu_A_FINAL_new_age_VF'
nbchains = 4
autochains = no

POPULATION:
exploratoryiterations = 1000
simulatedannealingiterations = 1000

